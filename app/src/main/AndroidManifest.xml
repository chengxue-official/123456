<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      热更新必需：Android 8.0(API 26)+ 安装 APK 需要此权限，否则
      canRequestPackageInstalls() 恒为 false、设置页也无开关，下载完装不上。
      （Android 6/7 走「未知来源」总开关，不依赖它）
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name="com.houg.tv.TvApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@mipmap/tv_banner">

        <activity
            android:name="com.houg.tv.MainActivity"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          除首页外都声明 behind：继承栈内上一个页面的方向。
          原来每个 Activity 都在 onCreate 里才 setRequestedOrientation，窗口先按设备
          当前方向（手机竖屏）创建、随后才转成 TV 横屏，于是「每进一个页面都转一次屏」。
          behind 让新页面一创建就沿用首页已经转好的横屏，代码里的 applyOrientation
          仍会显式设置一次（同值即无操作），手机端也仍然是竖屏。
        -->
        <activity
            android:name="com.houg.tv.SearchActivity"
            android:screenOrientation="behind"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name="com.houg.tv.DetailActivity"
            android:screenOrientation="behind"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name="com.houg.tv.HistoryActivity"
            android:screenOrientation="behind"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name="com.houg.tv.RankActivity"
            android:screenOrientation="behind"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name="com.houg.tv.CategoryActivity"
            android:screenOrientation="behind"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name="com.houg.tv.PlayerActivity"
            android:theme="@style/AppTheme.Fullscreen"
            android:screenOrientation="behind"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name="com.houg.tv.SettingsActivity"
            android:screenOrientation="behind"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name="com.houg.tv.LogActivity"
            android:screenOrientation="behind"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
