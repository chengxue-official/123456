<?xml version="1.0" encoding="utf-8"?>
<!--
  HOUG CINEMA 首页：顶部 mast（品牌行）+ 中央内容流（RecyclerView 统一承载
  Hero / 继续观看 / 今日热播 / 新上架）+ 底部 dock（主导航）。
  间距 token 由 MainActivity 按 TV / 手机形态注入（applyPageInsets）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- mast：品牌 + 搜索 + 工具（wrap_content：TV 时注入的 36dp paddingTop 不裁切按钮） -->
    <LinearLayout
        android:id="@+id/mast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/brand_accent"
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/app_title"
            style="@style/HougDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <TextView
            android:id="@+id/brand_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="CINEMA"
            android:textSize="8sp"
            android:textColor="@color/faint"
            android:letterSpacing="0.34" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/community_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/community_hint"
            android:textSize="12sp"
            android:textColor="@color/dim"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:gravity="center"
            android:background="@drawable/button_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/nav_search"
            android:textSize="12sp"
            android:textColor="@color/bone"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <ImageButton
            android:id="@+id/btn_update"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/tool_icon_bg"
            android:src="@drawable/ic_nav_update"
            android:scaleType="center"
            android:contentDescription="@string/nav_update"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- 当前时间：TV 全屏沉浸式下没有系统状态栏，时钟放在 mast 最右侧 -->
        <TextView
            android:id="@+id/clock_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/dim"
            android:letterSpacing="0.06"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- 中央内容流 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:clipToPadding="false" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty"
            android:textSize="14sp"
            android:textColor="@color/dim"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部 dock：主导航 -->
    <HorizontalScrollView
        android:id="@+id/dock_scroll"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/dock_bg"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dock_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/dock_home"
                style="@style/DockItem"
                android:tag="home">

                <TextView
                    android:id="@+id/dock_home_label"
                    style="@style/DockLabel"
                    android:text="@string/dock_home" />

                <View
                    android:id="@+id/dock_home_bar"
                    style="@style/DockBar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock_category"
                style="@style/DockItem"
                android:tag="category"
                android:layout_marginStart="24dp">

                <TextView
                    android:id="@+id/dock_category_label"
                    style="@style/DockLabel"
                    android:text="@string/nav_category" />

                <View
                    android:id="@+id/dock_category_bar"
                    style="@style/DockBar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock_rank"
                style="@style/DockItem"
                android:tag="rank"
                android:layout_marginStart="24dp">

                <TextView
                    android:id="@+id/dock_rank_label"
                    style="@style/DockLabel"
                    android:text="@string/nav_rank" />

                <View
                    android:id="@+id/dock_rank_bar"
                    style="@style/DockBar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock_search"
                style="@style/DockItem"
                android:tag="search"
                android:layout_marginStart="24dp">

                <TextView
                    android:id="@+id/dock_search_label"
                    style="@style/DockLabel"
                    android:text="@string/nav_search" />

                <View
                    android:id="@+id/dock_search_bar"
                    style="@style/DockBar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock_fav"
                style="@style/DockItem"
                android:tag="fav"
                android:layout_marginStart="24dp">

                <TextView
                    android:id="@+id/dock_fav_label"
                    style="@style/DockLabel"
                    android:text="@string/dock_fav" />

                <View
                    android:id="@+id/dock_fav_bar"
                    style="@style/DockBar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock_history"
                style="@style/DockItem"
                android:tag="history"
                android:layout_marginStart="24dp">

                <TextView
                    android:id="@+id/dock_history_label"
                    style="@style/DockLabel"
                    android:text="@string/nav_history" />

                <View
                    android:id="@+id/dock_history_bar"
                    style="@style/DockBar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock_settings"
                style="@style/DockItem"
                android:tag="settings"
                android:layout_marginStart="24dp">

                <TextView
                    android:id="@+id/dock_settings_label"
                    style="@style/DockLabel"
                    android:text="@string/dock_settings" />

                <View
                    android:id="@+id/dock_settings_bar"
                    style="@style/DockBar" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
