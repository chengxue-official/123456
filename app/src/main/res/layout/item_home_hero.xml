<?xml version="1.0" encoding="utf-8"?>
<!--
  首页 Hero（HOUG CINEMA）：海报全幅 + 双向压暗层 + 衬线大标题 + 主行动按钮。
  高度 TV 264dp / 手机 280dp（UiScale.isTv 代码选值）；「01」序号底纹手机端隐藏。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/home_hero_h"
    android:layout_marginBottom="12dp">

    <ImageView
        android:id="@+id/hero_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/cinema_core" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim" />

    <TextView
        android:id="@+id/hero_ghost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="-30dp"
        android:fontFamily="serif"
        android:text="01"
        android:textColor="@color/bone"
        android:alpha="0.06"
        android:textSize="140sp"
        android:includeFontPadding="false" />

    <LinearLayout
        android:id="@+id/hero_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="44dp">

        <TextView
            android:id="@+id/hero_eyebrow"
            style="@style/HougEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:letterSpacing="0.4"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/home_headline" />

        <TextView
            android:id="@+id/hero_title"
            style="@style/HougDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="42sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/hero_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_play"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:background="@drawable/btn_pri_bg"
                android:text="@string/home_play"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/hero_fav"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/button_bg"
                android:text="@string/home_join_list"
                android:textColor="@color/bone"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
