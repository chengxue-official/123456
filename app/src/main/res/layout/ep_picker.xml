<?xml version="1.0" encoding="utf-8"?>
<!-- 选集弹窗：半透明遮罩 + 右侧面板（关闭/跳转/上下组 + 集数网格）。
     include 进 activity_player.xml 最上层。默认 gone，菜单"选集"点亮。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ep_picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/ep_picker_panel"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="36dp"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="24dp">

        <TextView
            android:id="@+id/ep_picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 第一行：关闭 / 跳转集数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ep_btn_close"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="@string/ep_picker_close"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:background="@drawable/button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/ep_btn_jump"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="@string/ep_picker_jump"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:background="@drawable/button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- 第二行：上一组 / 下一组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ep_btn_prev"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="@string/ep_picker_prev_group"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:background="@drawable/button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/ep_btn_next"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="@string/ep_picker_next_group"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:background="@drawable/button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/ep_picker_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- 集数网格：代码动态填充（每页 20 格，5 列） -->
        <GridLayout
            android:id="@+id/ep_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5" />
    </LinearLayout>
</FrameLayout>
