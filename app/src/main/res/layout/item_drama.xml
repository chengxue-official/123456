<?xml version="1.0" encoding="utf-8"?>
<!--
  海报卡（HOUG CINEMA）：无卡片底色，封面自撑画面；聚焦时整格红框。
  卡片宽度由网格均分决定（match_parent + GridSpacingDecoration 间距），
  封面高度由 RatioCoverView 按 150:205 比例从宽度推出，任何分辨率下不变形不溢出。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="@drawable/poster_bg"
    android:focusable="true"
    android:clickable="true">

    <com.houg.tv.RatioCoverView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:background="@color/surface" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/bone"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/remark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/dim"
        android:textSize="11sp"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
