<?xml version="1.0" encoding="utf-8"?>
<!-- 首页右侧推荐栏条目：小封面 + 标题 + 热度（点击进详情） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/side_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="6dp"
    android:padding="8dp"
    android:background="@drawable/button_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/side_cover"
        android:layout_width="46dp"
        android:layout_height="61dp"
        android:scaleType="centerCrop"
        android:background="@drawable/poster_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/side_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bone"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/side_heat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/dim"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
