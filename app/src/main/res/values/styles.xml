<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HOUG CINEMA：暖黑影院主题，全屏沉浸 -->
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@drawable/bg_cinema</item>
        <item name="android:textColorPrimary">@color/bone</item>
        <item name="android:textColorSecondary">@color/dim</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 全屏主题（播放页用） -->
    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 衬线 display 标题（ mast 品牌 / 屏幕大标题） -->
    <style name="HougDisplay">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="HougDisplay.Brand">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.22</item>
    </style>

    <!-- 衬线小标（区块 eyebrow：如「今日热播」「继续观看」） -->
    <style name="HougEyebrow">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:letterSpacing">0.28</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 底部 dock 项（首页主导航：label + 下划线指示条） -->
    <style name="DockItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/dock_item_bg</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="DockLabel">
        <item name="android:fontFamily">serif</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <!-- 功能性导航文案：faint(#5D574F) 在暖黑底仅 2.6:1，提到 dim(9B948A) 达 6:1 -->
        <item name="android:textColor">@color/dim</item>
        <item name="android:letterSpacing">0.22</item>
    </style>

    <style name="DockBar">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:background">@color/accent</item>
    </style>

    <!-- 分类页大类切换 Tab（胶囊样式，复用筛选胶囊视觉） -->
    <style name="CategoryTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/filter_chip_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 榜单页切换 Tab（衬线，下划线式） -->
    <style name="RankBoardTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- ===== 设置页（HOUG CINEMA） ===== -->

    <!-- 分组面板：细描边 + 微渐变 -->
    <style name="SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/settings_grp_bg</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- 分组标题（衬线小标） -->
    <style name="SettingsGroupTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">12sp</item>
        <!-- 分组标题是内容索引，不是纯装饰：faint 2.6:1 太低，提到 dim -->
        <item name="android:textColor">@color/dim</item>
        <item name="android:letterSpacing">0.26</item>
    </style>

    <style name="SettingsGroupDesc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">10sp</item>
        <!-- 说明文字承载操作后果，属功能性小字，提到 dim 保证可读 -->
        <item name="android:textColor">@color/dim</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- 设置行 -->
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="SettingsHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">10sp</item>
        <!-- 行内提示说明取值含义，属功能性小字，提到 dim -->
        <item name="android:textColor">@color/dim</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- 右侧取值胶囊 -->
    <style name="SettingsOpt">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:minWidth">76dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">@drawable/settings_opt_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/settings_ctrl_text</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 动作按钮（与胶囊同视觉，稍宽） -->
    <style name="SettingsLink" parent="SettingsOpt">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- 顶部胶囊 Tab -->
    <style name="SettingsTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/settings_tab_bg</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/settings_tab_text</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 自定义开关（外层焦点框）；center_vertical：手机态运行时抬到 48dp 后轨道仍居中 -->
    <style name="SettingsSwitch">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">@drawable/settings_sw_focus</item>
        <item name="android:padding">3dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 开关轨道 -->
    <style name="SettingsSwitchTrack">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:padding">2dp</item>
        <item name="android:background">@drawable/switch_track_off</item>
        <item name="android:clipToPadding">false</item>
    </style>
</resources>
