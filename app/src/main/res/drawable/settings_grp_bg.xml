<?xml version="1.0" encoding="utf-8"?>
<!-- 设置分页分组面板：细描边 + 极淡竖向渐变（原型 .sgrp） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:endColor="#03F0EAE0"
        android:startColor="#09F0EAE0" />
    <stroke
        android:width="1dp"
        android:color="#1AF0EAE0" />
</shape>
