<?xml version="1.0" encoding="utf-8"?>
<!-- 胶囊 Tab：选中=品牌红实心；聚焦=红框；默认=hairline 描边透明底 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_light"/>
            <stroke android:width="@dimen/focus_stroke" android:color="@color/accent"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_light"/>
            <stroke android:width="@dimen/hairline" android:color="@color/hair_strong"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="@dimen/hairline" android:color="@color/hair"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
