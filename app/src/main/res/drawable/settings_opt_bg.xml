<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页取值胶囊 / 动作按钮：默认细描边，聚焦亮一圈品牌红（原型 .opt / .link） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/panel_focus" />
            <stroke
                android:width="2dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/panel_focus" />
            <stroke
                android:width="1dp"
                android:color="@color/hair_strong" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#0DF0EAE0" />
            <stroke
                android:width="1dp"
                android:color="#1FF0EAE0" />
        </shape>
    </item>
</selector>
