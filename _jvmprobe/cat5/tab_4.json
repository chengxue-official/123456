elpic.com/tos-cn-i-1yzifmftcy/9c720a7aa95b4fae985001812d0ba256~tplv-s85hriknmn-jpeg.heic?lk3s=afabcc2b&x-expires=1795627526&x-signature=0sY0AQyBCBj0sVYkWrIBPVNULaI%3D\",\"web_uri\":\"tos-cn-i-1yzifmftcy/9c720a7aa95b4fae985001812d0ba256\",\"mimetype\":\"\",\"width\":1080,\"height\":1440,\"aigc_image_id\":null,\"book_type\":0,\"text\":\"\",\"placeholder\":\"\",\"content\":\"\"}]}},{\"type\":\"tag_topic_mention\",\"data\":{\"web_url\":\"\",\"web_uri\":\"\",\"mimetype\":\"\",\"width\":0,\"height\":0,\"aigc_image_id\":null,\"book_type\":0,\"topic_tag\":{\"tag_id\":\"7602942671568524056\",\"tag\":\"请让他们再合作一次\",\"tag_type\":6,\"schema\":\"dragon8662://search?source=51&directQueryWord=%E8%AF%B7%E8%AE%A9%E4%BB%96%E4%BB%AC%E5%86%8D%E5%90%88%E4%BD%9C%E4%B8%80%E6%AC%A1&directSearchSourceId=post_topic_tag%231793112345D69EDD97%237602941909430059555%23%23&client_extra={\\\"topic_ids\\\":[\\\"7602941909430059555\\\"]}\",\"status\":1,\"tag_topic_id\":\"7602941909430059555\",\"extra\":{\"topic_id\":\"7602941909430059555\"}},\"text\":\"\",\"placeholder\":\"\",\"content\":\"\"}},{\"type\":\"series_card_id\",\"data\":{\"web_url\":\"\",\"web_uri\":\"\",\"mimetype\":\"\",\"width\":0,\"height\":0,\"series_card_id\":\"7630830352579185689\",\"aigc_image_id\":null,\"book_type\":0,\"text\":\"\",\"placeholder\":\"\",\"content\":\"\"}},{\"type\":\"series_card_id\",\"data\":{\"web_url\":\"\",\"web_uri\":\"\",\"mimetype\":\"\",\"width\":0,\"height\":0,\"series_card_id\":\"7616610835556731966\",\"aigc_image_id\":null,\"book_type\":0,\"text\":\"\",\"placeholder\":\"\",\"content\":\"\"}}],\"skeleton\":{\"data\":\"<cc_material_0 data-type=\\\"img-list\\\" /><h1>爱不是催你坚强是接住你</h1><p>很多女生不是不想被爱，只是更怕自己脆弱的时候没人接。可真正让人心软的CP，偏偏都是在她最难受的那一刻，没有让她一个人扛。</p><br/><p>《秦爷夫人又孕吐了》里，温暖那句“我一直怕自己配不上你”真的太真实了，像很多女生在感情里会偷偷藏起来的自卑。秦枭没有讲一堆大道理，而是直接把她抱进怀里，说“你不用急着追赶我，我等你”。还有早餐桌那场孕吐，她捂着嘴冲去洗手间，他连咖啡都碰倒了，慌得立刻叫医生。一个向来稳的人，因为你乱了方寸，真的很容易让人破防。</p><br/><p>《隐性暗恋》里，温以柠被背叛后的那种失重感也很戳心。她哭的时候，京墨不是逼她立刻振作，而是默默把她抱住；她后来找回记忆，终于知道他等了自己很多年，扑进他怀里那一下，他抱她的手都在抖。包括低谷时那句“你不是没人要，我一直都在”，听着就像有人把她碎掉的情绪一片片捡起来。</p><br/><p>我太爱这种关系了，你不用永远强大，因为总有人会认真接住你的软弱。<cc_material_1 data-type=\\\"tag_topic_mention\\\">#请让他们再合作一次</cc_material_1></p><cc_material_2 data-type=\\\"series_card_id\\\" /><cc_material_3 data-type=\\\"series_card_id\\\" />\",\"type\":\"html\"}}","post_type":22,"book_card":[],"tags":[],"reply_cnt":4,"digg_cnt":19,"has_digg":false,"create_time":1777213361,"title":"爱不是催你坚强是接住你","user_info":{"user_id":"3317692870694443","user_type":12,"user_name":"青鸟","user_avatar":"https://p3-novel.byteimg.com/img/novel-static/1437c63bc45b464bb1cc6cd6a7b0d4f1~tplv-1yzifmftcy-expand:200:0:0.png","is_author":false,"gender":2,"is_vip":false,"is_official_cert":false,"has_medal":false,"relation_type":1,"can_follow":true,"is_cancelled":false,"fans_schema":"dragon8662://webview?loadingButHideByFront=1&hideNavigationBar=1&bounceDisable=1&hideStatusBar=1&url=https%3A%2F%2Freading.snssdk.com%2Freading_offline%2fnovelread_community%2Fpage%2Fuser-social.html%3Ftab%3Dfans%26user_id%3D3317692870694443","follow_schema":"dragon8662://webview?loadingButHideByFront=1&hideNavigationBar=1&bounceDisable=1&hideStatusBar=1&url=https%3A%2F%2Freading.snssdk.com%2Freading_offline%2fnovelread_community%2Fpage%2Fuser-social.html%3Ftab%3Dfollow%26user_id%3D3317692870694443","encode_user_id":"#c1967_MTk2NzE5NjcxOTY3MTk2N4AwI5c2RWmj+mDFCjK8H4yrVkGX+7Q8gtEvUZ1mTsbM","ugc_read_book_count":0,"profile_gender":2,"user_sticker":{"sticker":null,"expire_time":0,"is_worn":false},"expand_user_avatar":"https://p3-novel.byteimg.com/img/novel-static/1437c63bc45b464bb1cc6cd6a7b0d4f1~tplv-1yzifmftcy-expand:200:0:0.png"},"ugc_privacy":0,"relative_type":0,"book_id":"0","pure_content":"爱不是催你坚强是接住你 很多女生不是不想被爱，只是更怕自己脆弱的时候没人接。可真正让人心软的CP，偏偏都是在她最难受的那一刻，没有让她一个人扛。 《秦爷夫人又孕吐了》里，温暖那句“我一直怕自己配不上你”真的太真实了，像很多女生在感情里会偷偷藏起来的自卑。秦枭没有讲一堆大道理，而是直接把她抱进怀里，说“你不用急着追赶我，我等你”。还有早餐桌那场孕吐，她捂着嘴冲去洗手间，他连咖啡都碰倒了，慌得立刻叫医生。一个向来稳的人，因为你乱了方寸，真的很容易让人破防。 《隐性暗恋》里，温以柠被背叛后的那种失重感也很戳心。她哭的时候，京墨不是逼她立刻振作，而是默默把她抱住；她后来找回记忆，终于知道他等了自己很多年，扑进他怀